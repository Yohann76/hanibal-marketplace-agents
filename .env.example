# External tools 

# Langfuse — clés du projet (Settings → API Keys dans l'interface LangFuse)
# En local : laisser vide → defaults docker-compose (pk-lf-oc-agents-local)
# En prod  : injectées automatiquement par Ansible via le vault
LANGFUSE_PUBLIC_KEY=pk-lf-9e0f8bac-f405-49c6-8ec4-39bf311afafd
LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST : ne pas surcharger, http://langfuse:3000 est correct dans tous les cas
# LANGFUSE_NEXTAUTH_URL : ne pas surcharger, géré par Ansible en prod

